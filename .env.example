# ==============================================================================
# WATCHLIST SAHAM - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and configure with your actual production secrets.
# NEVER commit your actual .env file to Git!
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER="watchlist_user"
POSTGRES_PASSWORD="generate_a_very_strong_password_here"
POSTGRES_DB="watchlist"

# For local direct connection without Docker:
# DATABASE_URL="postgresql://watchlist_user:password@localhost:5432/watchlist?schema=public"

# For Docker Compose (automatically interpolated):
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public"

# Application Data Provider ('database' | 'yahoo')
DATA_PROVIDER="database"

# ETL & Background Sync Configuration
SYNC_INTERVAL_MINS=5
DEEP_SYNC_HOUR=00

# Authentication & Security
# Generate with: openssl rand -base64 32
JWT_SECRET="generate_a_very_strong_random_jwt_secret_here"

# Administrative API Key (Protects /api/admin/* and /api/ksei/ingest)
ADMIN_SECRET_KEY="generate_a_very_strong_admin_secret_key_here"

# Discord Webhook Notification (Daily picks & Real-time WIN/LOSS alerts)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"
