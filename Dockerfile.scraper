# ── Stage 1: Install ONLY scraper dependencies ──────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app

# Create a minimal package.json with only the packages the scraper needs
# (no Next.js, no React, no lightweight-charts)
RUN echo '{"private":true,"dependencies":{"@prisma/client":"^6.12.0","puppeteer":"^25.8.0","node-cron":"^4.6.0","prisma":"^6.12.0","adm-zip":"^0.5.16","yahoo-finance2":"^3.14.0","dotenv":"^16.4.7"}}' > package.json
RUN npm install --prefer-offline --no-audit && \
    npm cache clean --force

# ── Stage 2: Production runner ──────────────────────────────────────────────
FROM node:20-alpine AS runner

# Install Chromium, native libraries, and tzdata for Puppeteer and Cron on Alpine
RUN apk add --no-cache \
      chromium \
      nss \
      freetype \
      harfbuzz \
      ca-certificates \
      ttf-freefont \
      openssl \
      tzdata && \
    rm -rf /var/cache/apk/*

# Configure Puppeteer and Timezone to Asia/Jakarta (WIB)
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser \
    NODE_ENV=production \
    TZ=Asia/Jakarta

WORKDIR /app

# Copy only the minimal node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy Prisma schema, core business logic lib, and scraper scripts
COPY prisma ./prisma
COPY src/lib ./src/lib
COPY src/scripts ./src/scripts

# Generate Prisma Client for Alpine (musl)
RUN npx prisma generate

# Start the node-cron scheduler
CMD ["node", "src/scripts/scraper-cron.js"]
