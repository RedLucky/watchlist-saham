FROM node:20-alpine

# Install Chromium and required native runtime libraries for Alpine
RUN apk add --no-cache \
      chromium \
      nss \
      freetype \
      harfbuzz \
      ca-certificates \
      ttf-freefont \
      openssl && \
    rm -rf /var/cache/apk/*

# Configure Puppeteer to use Alpine's installed Chromium binary
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser \
    NODE_ENV=production

WORKDIR /app

# Install production dependencies only & clean npm cache
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev --prefer-offline --no-audit && \
    npm cache clean --force

# Copy source code and Prisma schema
COPY . .

# Generate Prisma Client
RUN npx prisma generate

# Start the node-cron scheduler
CMD ["node", "src/scripts/scraper-cron.js"]
